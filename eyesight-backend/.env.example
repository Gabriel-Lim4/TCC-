# Copie para .env. Nunca versione credenciais reais; defina cada variável uma única vez.

FRONTEND_URL=http://localhost:5173
# Origens extras autorizadas a chamar a API pelo navegador (separadas por vírgula). A FRONTEND_URL já é permitida.
# CORS_ORIGINS=https://admin.exemplo.com

# Obrigatória em produção (o servidor não sobe sem ela): 32 bytes em base64 ou 64 caracteres hexadecimais.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# TOKEN_ENCRYPTION_KEY=
# Saída consciente, só se aceitar guardar os tokens em texto puro:
# ALLOW_PLAINTEXT_TOKENS=true
