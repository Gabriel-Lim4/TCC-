generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model usuarios {
  pk_id_usuario     Int                 @id @default(autoincrement())
  nome_usuario      String              @db.VarChar(100)
  data_criacao_user DateTime?           @default(now())
  auth_user_id      String?             @unique @db.Uuid
  telefone          String?             @db.VarChar(30)
  localizacao       String?             @db.VarChar(150)
  preferences       Json?
  conversations     assistant_conversations[]
  analises          analises_ia[]
  planos            planos_acao[]
  rotinas           rotina_envios[]
  contas            contas_vinculadas[]
}

model contas_vinculadas {
  pk_id_conta   Int                          @id @default(autoincrement())
  fk_id_usuario Int
  plataforma    contas_vinculadas_plataforma
  acess_token   String
  account_id    String                       @db.VarChar(100)
  refresh_token String?
  token_expires_at DateTime?
  account_name  String?                      @db.VarChar(200)
  currency      String?                      @db.VarChar(3)
  time_zone     String?                      @db.VarChar(100)
  vinculado_em  DateTime?                    @default(now())
  campanhas     campanhas[]
  usuario       usuarios                     @relation(fields: [fk_id_usuario], references: [pk_id_usuario], onDelete: Cascade)

  @@unique([fk_id_usuario, plataforma], name: "fk_id_usuario_plataforma")
  @@index([fk_id_usuario])
}

model campanhas {
  pk_id_campanha  Int               @id @default(autoincrement())
  fk_id_conta     Int
  id_externo      String            @db.VarChar(100)
  nome_campanha   String            @db.VarChar(200)
  status_campanha String?           @db.VarChar(50)
  objetivo        String?           @db.VarChar(100)
  sincronizado_em DateTime?         @default(now())
  analises        analises_ia[]
  conta           contas_vinculadas @relation(fields: [fk_id_conta], references: [pk_id_conta], onDelete: Cascade)
  metricas        metricas[]
  daily_metrics   campaign_daily_metrics[]

  @@unique([fk_id_conta, id_externo], map: "campanhas_conta_id_externo_key")
  @@index([fk_id_conta])
}

model metricas {
  pk_id_metrica   Int       @id @default(autoincrement())
  fk_id_campanha  Int
  tipo_metrica    String    @db.VarChar(100)
  valor_metrica   Decimal   @db.Decimal(15, 4)
  periodo_metrica String    @db.VarChar(50)
  coletado_em     DateTime? @default(now())
  campanha        campanhas @relation(fields: [fk_id_campanha], references: [pk_id_campanha], onDelete: Cascade)

  @@index([fk_id_campanha])
}

model analises_ia {
  pk_id_analise        Int       @id @default(autoincrement())
  fk_id_usuario        Int
  fk_id_campanha       Int
  texto_analise        String?
  sugestao_analise     String?
  score_desempenho     Int?
  modelo              String?
  periodo             String?   @db.VarChar(50)
  data_geracao_analise DateTime? @default(now())
  campanha             campanhas @relation(fields: [fk_id_campanha], references: [pk_id_campanha], onDelete: Cascade)
  usuario              usuarios  @relation(fields: [fk_id_usuario], references: [pk_id_usuario], onDelete: Cascade)

  @@index([fk_id_campanha])
  @@index([fk_id_usuario])
}

enum contas_vinculadas_plataforma {
  meta
  google
}

model campaign_daily_metrics {
  id          Int       @id @default(autoincrement())
  campaign_id Int
  date        DateTime  @db.Date
  values      Json
  synced_at   DateTime  @default(now())
  campaign    campanhas @relation(fields: [campaign_id], references: [pk_id_campanha], onDelete: Cascade)

  @@unique([campaign_id, date])
  @@index([date])
}

model assistant_conversations {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    Int
  title      String   @db.VarChar(150)
  messages   Json
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       usuarios @relation(fields: [user_id], references: [pk_id_usuario], onDelete: Cascade)

  @@index([user_id, updated_at])
}

model planos_acao {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     Int
  action_key  String   @db.VarChar(80)
  action_code String   @db.VarChar(50)
  campaign_id Int?
  steps       Json
  generated_at DateTime @default(now()) @db.Timestamptz(6)
  last_seen_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  user        usuarios @relation(fields: [user_id], references: [pk_id_usuario], onDelete: Cascade)

  @@unique([user_id, action_key], map: "planos_acao_user_action_key")
  @@index([user_id, last_seen_at])
}

model rotina_envios {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    Int
  kind       String   @db.VarChar(30)
  period_key String   @db.VarChar(10)
  sent_at    DateTime @default(now()) @db.Timestamptz(6)
  user       usuarios @relation(fields: [user_id], references: [pk_id_usuario], onDelete: Cascade)

  @@unique([user_id, kind, period_key], map: "rotina_envios_user_kind_period_key")
}
